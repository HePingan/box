<?xml version="1.0" encoding="utf-8"?>
<!-- 伪装图标的背景层（四象限版，仅自适应图标引用）。
     数值来自源图标实测：左上 #F1F1F1、右上 #FAFAFA、左下 #FFFFFF、右下 #EFEFEF。
     差别只有 4% 亮度，单独看不出来，但叠在一起就是那点「设计感」的质感，
     纯色版在并排对比时显得平板。
     尺寸写 54dp 而不是 50%：自适应图标背景层的画布就是 108dp，54dp 正好一半；
     而 aapt2 不接受 `<item android:width>` 上的百分比（报 "'50%' is incompatible
     with attribute width (attr) dimension"），会让整包资源链接失败。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_calculator_quad_br" />
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="top|left"
        android:drawable="@color/ic_calculator_quad_tl" />
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="top|right"
        android:drawable="@color/ic_calculator_quad_tr" />
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="bottom|left"
        android:drawable="@color/ic_calculator_quad_bl" />
</layer-list>
