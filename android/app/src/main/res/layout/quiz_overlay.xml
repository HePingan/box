<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 答案展示层 -->
    <LinearLayout
        android:id="@+id/answer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/quiz_overlay_bg"
        android:elevation="10dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 标题栏（仅此区域可拖动） -->
        <!-- ===== 标题栏（用户 2026-09-15 拍板方案 A：按钮区可横向滑动）=====
             结构：
               [左侧拖动区: 相似度胶囊 + 占位]  [HorizontalScrollView: 6 个功能按钮]
             拖动区在滑动区之外 → 横向滑动不会抢走拖窗手势；
             滑动区内部才可横滑，两侧互不干扰。
             窗口宽度不足时按钮可滑动取用，不再被右侧裁掉。 -->
        <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:background="@drawable/quiz_overlay_title_bg">

            <!-- ===== 左侧：拖动手柄区（不参与横向滑动）=====
                 双击此区域仍触发折叠/展开；横向拖动此区域移动整个悬浮窗。
                 相似度胶囊放这里，既不挤占按钮滑动区，又天然成为拖动热区。 -->
            <TextView
                android:id="@+id/tv_similarity_badge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="0dp"
                android:maxWidth="44dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:background="@drawable/quiz_similarity_badge_bg"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="检索中"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- 拖动死区：胶囊与按钮滑动区之间的固定空白，专供拖窗/双击。
                 有真实宽度（非 0dp），确保手指一定有地方能抓住窗口拖动。
                 importantForAccessibility=no：它是纯手势热区、无独立语义，
                 否则 TalkBack 会把「拖动窗口」当成一个点不动的幽灵节点念出来。 -->
            <View
                android:id="@+id/title_drag_handle"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <!-- 状态色条已并入胶囊，保留 id 供旧逻辑兼容（1dp 不可见） -->
            <View
                android:id="@+id/status_bar"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <!-- ===== 右侧：可横向滑动的按钮区 =====
                 scrollbars=none：标题栏只有 36dp 高，滚动条会压住按钮。
                 overScrollMode=never：避免滑到尽头出现光晕，干扰浮层观感。 -->
            <HorizontalScrollView
                android:id="@+id/title_actions_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fillViewport="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/title_actions_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

            <!-- 溢出菜单：区域选择 / 一键录入等低频动作收进这里，给眼睛留出空间 -->
            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:padding="5dp"
                android:src="@drawable/ic_more_overlay"
                android:background="@drawable/quiz_title_action_bg"
                android:foreground="@drawable/quiz_btn_ripple"
                android:scaleType="fitCenter"
                android:tint="#F8FAFC"
                android:alpha="0.95"
                android:contentDescription="更多功能（识别区域 / 一键录入）" />
            <!-- AI 读屏：唯一「联网搜题」入口。
                 用户 2026-09-13 第三次反馈：按钮带 sparkle 图标太宽，挤掉了
                 左边的相似度胶囊。去掉图标、收窄到纯「AI」文字胶囊。 -->
            <LinearLayout
                android:id="@+id/btn_ai_vision"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:minWidth="0dp"
                android:background="@drawable/quiz_ai_button_bg"
                android:foreground="@drawable/quiz_btn_ripple"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="AI 联网搜题">
                <TextView
                    android:id="@+id/tv_ai_vision_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- 框选识别范围：用户 2026-09-13 第五次反馈「帮框选识别范围的按钮
                 也加回来」——此前为了保证标题栏不溢出，把它收进了 ⋯ 菜单，
                 但用户找不到。现恢复为标题栏常驻按钮（眼睛图标，与「隐藏为
                 小圆点」区分：这里是「框选」语义，用裁剪框图标）。
                 宽度 26dp，与其它图标按钮一致；标题栏不够宽时会被
                 applyTitleBarAdaptation 按优先级收起（眼睛/AI 优先保留）。 -->
            <ImageButton
                android:id="@+id/btn_region_entry"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_region_select"
                android:background="@drawable/quiz_title_action_bg"
                android:foreground="@drawable/quiz_btn_ripple"
                android:scaleType="fitCenter"
                android:tint="#F8FAFC"
                android:alpha="0.95"
                android:contentDescription="框选识别范围" />

            <ImageButton
                android:id="@+id/btn_hide_overlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="3dp"
                android:padding="5dp"
                android:src="@drawable/ic_eye_overlay"
                android:background="@drawable/quiz_title_action_bg"
                android:foreground="@drawable/quiz_btn_ripple"
                android:scaleType="fitCenter"
                android:tint="#F8FAFC"
                android:alpha="0.95"
                android:contentDescription="隐藏为小圆点" />

            <!-- 录入题目：用户 2026-09-13 明确要求「保留录入题目按钮」直接可见，
                 不再藏进 ⋯ 菜单。图标 + 短标签，宽度与眼睛一致（26dp）。 -->
            <ImageButton
                android:id="@+id/btn_quiz_entry"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="3dp"
                android:padding="5dp"
                android:src="@drawable/ic_quiz_entry_overlay"
                android:background="@drawable/quiz_title_action_bg"
                android:foreground="@drawable/quiz_btn_ripple"
                android:scaleType="fitCenter"
                android:tint="#F8FAFC"
                android:alpha="0.95"
                android:contentDescription="录入题目" />

            <!-- 右安全边距（2026-09-18 截图定位「录入」按钮贴窗口右缘被裁）：
                 12dp 留白从 title_actions_row 的 paddingEnd 移到内容里固定宽度的 Space。
                 机制：HorizontalScrollView clipToPadding=false + fillViewport=false，
                 超宽时 padding 会被吞、末按钮贴边裁切；而内容自带的 Space 随内容滚动，
                 滚到最右仍有 12dp 余量。importantForAccessibility=no：纯留白热区，
                 免 TalkBack 念出幽灵节点。 -->
            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <!-- 关闭按钮已移除（用户 2026-09-13：「那个叉没有必要」）。
                 保留 id 为恒 GONE 占位，避免旧 findViewById 路径 NPE。 -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:contentDescription="关闭（已废弃）" />

            <!-- 区域/折叠/探针等保留旧 id 供无障碍/普通浮窗路径兼容。 -->
            <View android:id="@+id/btn_area" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <View android:id="@+id/btn_collapse" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <View android:id="@+id/btn_probe" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <View android:id="@+id/btn_search" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                </LinearLayout><!-- /title_actions_row -->
            </HorizontalScrollView><!-- /title_actions_scroll -->
        </LinearLayout>

        <!-- 状态行：已并入标题栏胶囊（2026-09-13 第二轮优化）。
             保留容器与 id 供旧渲染路径 findViewById 兼容，但高度归零不占位。 -->
        <LinearLayout
            android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone" />


        <!-- 题目区：限高，长题干在区内自滚，不挤占答案首屏 -->
        <ScrollView
            android:id="@+id/scroll_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="80dp"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:background="#FFFFFF"
                android:text="等待捕获题目…"
                android:textColor="#101828"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="false" />
        </ScrollView>

        <View
            android:id="@+id/answer_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E6EAF2" />

        <!-- 读屏进度区：仅 AI 读屏期间可见。
             用户 2026-09-13 第三次反馈「ai搜索时没有看到提示与进度」——
             旧实现只有一条 2dp 细线，且倒计时文案写进**相似度胶囊**，
             而窄窗下胶囊会被自适应收起 → 进度写进不可见的 View，等于没提示。
             现改为「独立横幅（文字 + 进度条）」，不依赖胶囊是否可见。 -->
        <LinearLayout
            android:id="@+id/vision_progress_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF7E6"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_vision_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:text="正在识别题目…"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/vision_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#F59E0B"
                android:progressBackgroundTint="#FDE68A" />
        </LinearLayout>

        <!-- 答案区：**不**再独占剩余高度（weight），否则它会把下方的 AI 过程框
             顶出窗外、被窗口底边裁掉 —— 用户 2026-09-14 反馈「ai搜题这个显示咋
             只有一半，我看不完全」的真因就是它。
             改为：内容驱动(wrap_content) + 自身可滚(maxHeight)，把剩余空间让给
             过程框；AI 过程框常驻在最底部（窗口内），永远看得全。 -->
        <ScrollView
            android:id="@+id/scroll_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="#F8FAFC"
                android:text="等待搜题结果…"
                android:textColor="#344054"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="false" />
        </ScrollView>

        <!-- AI 作答过程：用户 2026-09-13 第五次反馈「ai回答时在答题悬浮窗下面
             显示作答过程」。显示 AI 识图/推理/检索各阶段耗时与结论依据，
             默认收起（不打断看答案），有过程内容时展开为可滚动的窄条。
             注意：这是「过程」不是「思维链原文」——只展示可核对的阶段记录，
             避免把上游模型的英文思维链直接糊给用户。 -->
        <LinearLayout
            android:id="@+id/ai_process_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ai_process_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="#E2E8F0">

                <TextView
                    android:id="@+id/tv_ai_process_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI 作答过程"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_ai_process_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开"
                    android:textColor="#4F46E5"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll_ai_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"
                android:minHeight="40dp"
                android:visibility="gone"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_ai_process"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 隐身态入口：仅显示极小半透明眼睛圆点，点击立即恢复完整答案窗。 -->
    <ImageButton
        android:id="@+id/hidden_dot"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_eye_overlay"
        android:background="@drawable/quiz_hidden_dot_bg"
        android:foreground="@drawable/quiz_btn_ripple"
        android:padding="6dp"
        android:tint="#FFFFFF"
        android:alpha="0.48"
        android:visibility="gone"
        android:contentDescription="展开答题悬浮窗" />

    <!-- 折叠态小药丸（整卡可点展开，也可拖动） -->
    <LinearLayout
        android:id="@+id/collapsed_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="@drawable/quiz_overlay_title_bg"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_help"
            android:tint="#FFFFFF"
            android:alpha="0.95" />

        <TextView
            android:id="@+id/tv_pill_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="答题助手"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_expand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_chevron_down"
            android:background="@android:color/transparent"
            android:foreground="@drawable/quiz_btn_ripple"
            android:scaleType="center"
            android:tint="#FFFFFF"
            android:alpha="0.85"
            android:contentDescription="展开" />
    </LinearLayout>

    <!-- 右下角缩放手柄 -->
    <ImageView
        android:id="@+id/resize_handle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:padding="8dp"
        android:src="@drawable/ic_resize_handle"
        android:tint="#4F46E5"
        android:background="@drawable/quiz_resize_handle_bg"
        android:alpha="0.95"
        android:scaleType="fitCenter"
        android:contentDescription="缩放" />

    <!-- 兼容旧代码：隐藏的 font 按钮 id，避免 findViewById 全改 -->
        <ImageButton
            android:id="@+id/btn_font"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="字号" />

        <!-- 识别区域调节层（默认隐藏） -->
        <top.hpa888.box.RegionSelectorView
            android:id="@+id/region_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@android:color/transparent" />

        <!-- 区域调节工具栏：轻量主操作 + 可展开更多 -->
        <!-- 位置：贴底部，避免顶部文字/按钮遮挡选区上边缘与顶部手柄 -->
        <LinearLayout
            android:id="@+id/region_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/quiz_overlay_title_bg"
            android:visibility="gone"
            android:elevation="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_region_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="拖动四角调整识别区域"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <Button
                    android:id="@+id/btn_region_cancel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="取消"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_region_probe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="试捕"
                    android:textColor="#FDE68A"
                    android:textSize="13sp"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_region_save"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:text="保存并搜题"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_region_more"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="更多"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/region_more_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="2dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:scrollbars="none"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_preset_top"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="题干带"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_preset_mid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="中部"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_preset_full"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="全屏"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_preset_last"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="上次"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_region_ocr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCR试识"
                            android:textColor="#FDE68A"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_region_aspect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="比例:自由"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 试捕/OCR 预览（默认隐藏） -->
                <LinearLayout
                    android:id="@+id/region_probe_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_probe_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="试捕预览"
                        android:textColor="#FDE68A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tv_probe_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:text="—" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <Button
                            android:id="@+id/btn_probe_copy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="一键复制"
                            android:textColor="#FDE68A"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="2dp" />

                        <Button
                            android:id="@+id/btn_probe_search"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用此文本搜题"
                            android:textColor="#FDE68A"
                            android:background="@android:color/transparent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
