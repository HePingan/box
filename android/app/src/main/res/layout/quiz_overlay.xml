<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 答案展示层 -->
    <LinearLayout
        android:id="@+id/answer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/quiz_overlay_bg"
        android:elevation="8dp"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:background="#4F46E5">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="答题助手"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_font"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_add"
                android:background="@null"
                android:scaleType="center"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:contentDescription="字号" />

            <ImageButton
                android:id="@+id/btn_collapse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/arrow_up_float"
                android:background="@null"
                android:scaleType="center"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:contentDescription="折叠" />

            <ImageButton
                android:id="@+id/btn_area"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_crop"
                android:background="@null"
                android:scaleType="center"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:contentDescription="选择识别区域" />

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@null"
                android:scaleType="center"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:contentDescription="搜题" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@null"
                android:scaleType="center"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:contentDescription="关闭" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:text="等待捕获题目…"
            android:textColor="#101828"
            android:textSize="14sp"
            android:maxLines="6"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E6EAF2" />

        <TextView
            android:id="@+id/tv_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:text="等待搜题结果…"
            android:textColor="#667085"
            android:textSize="13sp"
            android:maxLines="8"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- 右下角缩放手柄（拖动改变悬浮窗大小） -->
    <ImageView
        android:id="@+id/resize_handle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_crop"
        android:tint="#4F46E5"
        android:background="#FFFFFF"
        android:alpha="0.9"
        android:scaleType="fitCenter"
        android:contentDescription="缩放" />

    <!-- 识别区域调节层（默认隐藏） -->
    <com.example.box.RegionSelectorView
        android:id="@+id/region_selector"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#33000000" />

    <!-- 区域调节顶部工具栏 -->
    <LinearLayout
        android:id="@+id/region_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#4F46E5"
        android:visibility="gone"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="调节识别区域"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_region_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_region_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

</FrameLayout>
