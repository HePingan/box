<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activity 窗口底色。必须与 Flutter 侧 AppTokens.background
         (lib/design_system/app_tokens.dart) 保持一致。

         这个值会在两个时机被用户看到：
         1. 冷启动时 Flutter 首帧之前
         2. SurfaceView 的 surface 重建期间（小窗拖拽缩放时）

         原先浅色用 ?android:colorBackground（Theme.Light 下是纯白）、
         深色继承 Theme.Black（纯黑），两者都和 #F4F7FB 有明显色差，
         在红米 K80(HyperOS) 小窗缩放时表现为刺眼的白屏。

         改这个值时记得同步 AppTokens.background，
         test/android_window_background_test.dart 会校验两者一致。 -->
    <color name="window_background">#F4F7FB</color>

    <!-- 伪装图标不再有矢量/自适应版本，全部颜色都已烘进 mipmap-*/ic_calculator.png
         （由 tool/gen_disguise_icon.py 从真机 app_icon 的 128px 拟合出矢量、按目标dp
         各密度重新栅格化；128px 直接拷会被桌面放大到糊）。
         所以这里原先那 5 个 ic_calculator_* 颜色已经删除，别再加回来。 -->

    <!-- ===== 答题悬浮窗配色（2026-11-18 审计 P2-7：暗色适配） =====
         这些颜色原先全部硬编码在 quiz_overlay.xml / drawable/quiz_overlay_bg.xml 里，
         夜间（系统深色）依然是纯白卡片 + 深灰字 ⇒ 深色题库 App 上白得刺眼。
         现在抽成资源，values-night/colors.xml 给深色版本；纯资源改动，代码零改动。
         ⚠️ 新增颜色必须同时在 values-night 里给一份，否则夜间会回落到白色。 -->
    <color name="quiz_overlay_surface">#FFFFFF</color>
    <color name="quiz_overlay_surface_alt">#F8FAFC</color>
    <color name="quiz_overlay_surface_soft">#F1F5F9</color>
    <color name="quiz_overlay_text_primary">#101828</color>
    <color name="quiz_overlay_text_secondary">#344054</color>
    <color name="quiz_overlay_text_muted">#475569</color>
    <color name="quiz_overlay_divider">#E2E8F0</color>
    <color name="quiz_overlay_stroke">#D0D5DD</color>
    <color name="quiz_overlay_icon_tint">#F8FAFC</color>
</resources>
