<?xml version="1.0" encoding="utf-8"?>
<!-- 伪装图标的背景层（纯色兜底）。
     源图标（vivo 计算器）的背景其实是四象限几乎等亮的浅灰（#F1F1F1 / #FAFAFA /
     #FFFFFF / #EFEFEF，差值 4% 以内）；这里给纯色兜底，四象限版本在
     drawable-v26/ic_calculator_background.xml —— 那边的 item 用了 API 23 才有的
     android:width/height，只有自适应图标（API 26+）会引用它。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ic_calculator_background" />
</shape>
