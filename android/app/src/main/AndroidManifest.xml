<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 允许应用访问网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 允许应用获取网络状态（视频播放器判断网络环境需要） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 存储权限：用来把下载的 APK 存到手机里以便安装 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- 答题插件：悬浮窗/通知兜底权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 答题插件：无障碍服务绑定 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <!-- 视频下载：前台服务权限（Android 14+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 分贝仪要读麦克风振幅。运行时动态申请（record 插件的 hasPermission）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 说明：曾声明 USE_EXACT_ALARM（注释称"断点续传恢复"），已于本次移除。
         原生侧全库没有 AlarmManager / setExact / canScheduleExactAlarms 的调用，
         续传实际靠 VideoDownloadService 前台服务 + DownloadTaskStore 落盘，
         不依赖闹钟。USE_EXACT_ALARM 属于 Android 13+ 的高敏感权限，
         多余声明既要在隐私政策里解释，也是应用商店审核的扣分项。
         若将来真要做「到点自动续传」，请改用 WorkManager，而不是恢复本权限。 -->

    <application
        android:label="box"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- allowBackup=false（C1）：本地持久化里只有登录 token 与远程存储的
             应用密码（密文 + 每安装密钥材料同在一处）。开启备份/换机迁移等于把
             密文与密钥一起交出去，而本应用没有任何"必须靠备份恢复"的服务端状态。
             dataExtractionRules 是 Android 12+ 上对应开关的显式声明（两者都要写，
             否则 12+ 上 D2D 迁移仍可能带上应用数据）。 -->

        <!-- resizeableActivity="true"：阅读类 App 会被用户放进小窗，必须声明
             支持任意尺寸。未声明时部分 ROM（红米 K80 / HyperOS 的 freeform）
             会走自己的兼容缩放路径而非标准 resize，加剧小窗拖拽缩放时的
             surface 尺寸协商问题。
             依赖下面的 configChanges 拦住尺寸变化，Activity 不重建，
             阅读进度才不会丢。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 接收系统分享（286 P3，287 D3 起也收文本/链接）。
                 为什么拆成多个 filter 而不是一个用 mimeType="*/*"：声明越具体，
                 系统「分享到」列表里出现本应用的场景越可控。
                 286 时只收图片与视频，理由是"收文本没有明确落点"；286 P3 之后
                 每个分享都会先弹落点面板（选账户 + 目标目录）再进传输队列，
                 这个顾虑不再成立，于是 287 D3 把 text/plain 也收进来 ——
                 纯文本/链接会在原生侧落成一个 .txt 再走同一条上传队列。
                 仍然**不收任意文件**（application/*）：那种分享里最常见的是一堆
                 装不进"传到哪里"心智的二进制，先不接。
                 SEND 单个 / SEND_MULTIPLE 多选都要声明：相册多选分享走的是后者。
                 launchMode=singleTop（见上），热启动走 onNewIntent，不会重建 Activity。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
        </activity>

        <!-- 答题插件：无障碍服务 -->
        <service
            android:name=".QuizAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quiz_accessibility_config" />
        </service>

        <!-- 视频下载前台服务 -->
        <service
            android:name=".VideoDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 远端存储传输保活前台服务（284 P1）：传输入队期间挂着，防止后台被回收 -->
        <service
            android:name=".TransferKeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
